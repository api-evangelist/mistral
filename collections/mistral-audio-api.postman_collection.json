          "name": "Mistral AI Create an audio transcription",
          "request": {
            "name": "Mistral AI Create an audio transcription",
            "description": {
              "content": "Transcribe audio to text using Voxtral. Supports multiple audio formats, speaker diarization, word-level timestamps, context biasing with custom vocabulary, and 13 languages.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "audio",
                "transcriptions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "model",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) The transcription model to use"
                },
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) The audio file to transcribe (WAV, MP3, FLAC, OGG, M4A, WEBM)"
                },
                {
                  "key": "language",
                  "value": "<string>",
                  "type": "text",
                  "description": "ISO 639-1 language code. If not specified, the language is auto-detected."
                },
                {
                  "key": "prompt",
                  "value": "<string>",
                  "type": "text",
                  "description": "Context or vocabulary hints to improve transcription accuracy. Useful for domain-specific terminology."
                },
                {
                  "key": "response_format",
                  "value": "json",
                  "type": "text",
                  "description": "Output format for the transcription (This can only be one of json,text,verbose_json)"
                },
                {
                  "key": "temperature",
                  "value": "0",
                  "type": "text",
                  "description": "Sampling temperature for transcription"
                },
                {
                  "key": "timestamp_granularities",
                  "value": "[\"<string>\",\"<string>\"]",
                  "type": "text",
                  "description": "Granularity levels for timestamps"
                },
                {
                  "key": "diarization",
                  "value": "false",
                  "type": "text",
                  "description": "Whether to enable speaker diarization"
                }
              ]
            }
